# Optional. The app uses these defaults when the variables are unset.
# On Vercel, set Root Directory to frontend. Leave NEXT_PUBLIC_NEAR_NETWORK as testnet.
# The app refuses a mainnet wallet connection.
NEXT_PUBLIC_CONTRACT_ID=diabloodevs.testnet
NEXT_PUBLIC_SPONSOR_CONTRACT_ID=sponsor.diabloodevs.testnet
NEXT_PUBLIC_MISSION_CONTRACT_ID=missions.diabloodevs.testnet
NEXT_PUBLIC_TREASURY_CONTRACT_ID=treasury.diabloodevs.testnet
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
